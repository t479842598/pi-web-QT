# Pi Web relay — environment file.
# Copy to /etc/pi-web-relay.env and set the public URL.

# Port the relay listens on (behind the reverse proxy).
RELAY_PORT=8787

# Bind to loopback only; the reverse proxy is the public entry point.
RELAY_HOST=127.0.0.1

# Optional shared password. Leave empty to rely on pairing tokens alone —
# recommended for a personal server, since every session still needs a
# valid one-time token.
RELAY_PASSWORD=

# Shared secret the desktop must present to register as a device.
# REQUIRED for any publicly reachable relay: without it, anyone who can reach
# the relay could claim a device id, evict the real desktop, and mint tokens.
# Generate with: openssl rand -hex 32
RELAY_DEVICE_SECRET=

# Public base URL. Used for display and to build the QR link that the
# desktop shows. Must match the reverse proxy's HTTPS host.
RELAY_PUBLIC_URL=https://relay.example.com
