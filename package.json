{
  "name": "@qt4798/pi-web",
  "version": "0.9.5",
  "description": "Web workspace for the pi coding agent",
  "homepage": "https://github.com/t479842598/pi-web-QT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t479842598/pi-web-QT.git"
  },
  "bugs": {
    "url": "https://github.com/t479842598/pi-web-QT/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 0 --turbopack",
    "dev:lan": "next dev -H 0.0.0.0 -p 0 --turbopack",
    "build": "env -u TURBOPACK next build --webpack",
    "start": "next start -H 127.0.0.1 -p 0",
    "start:lan": "next start -H 0.0.0.0 -p 0",
    "lint": "eslint .",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "test": "node --experimental-strip-types --test $(find app components hooks lib -name '*.test.mjs' -print)"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@fontsource/ia-writer-quattro": "^5.3.0",
    "@fontsource/lilex": "^5.3.0",
    "@lobehub/icons": "^5.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react-syntax-highlighter": "^15.5.13",
    "adm-zip": "^0.6.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "next": "16.2.12",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "8.5.0"
  },
  "overrides": {
    "@emoji-mart/react": {
      "react": "$react"
    }
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "postcss": "^8",
    "tailwindcss": "^4.2.2",
    "to-ico": "^1.1.5",
    "typescript": "^5.9.3"
  }
}
