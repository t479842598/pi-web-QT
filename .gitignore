nul

# production
/build
/release

# electron
electron/node_modules/

# tauri (remnants from previous Tauri migration, kept to prevent re-inclusion)
src-tauri/
tauri-dist/
build-app/
build-temp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory

.myLastChat
ref-repos
.lrnev/
.reasonix/

# pi todo tool local state
/.pi/

