<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleDisplayName</key>
    <string>Pi Web Server</string>
    <key>CFBundleExecutable</key>
    <string>node</string>
    <!--
      Must match the parent app identifier (com.piweb.desktop). A distinct
      helper bundle ID makes macOS Sequoia+ treat Node file access as a separate
      app (SystemPolicyAppData) and re-prompt "access data from other apps" on
      every launch even after Allow.
    -->
    <key>CFBundleIdentifier</key>
    <string>com.piweb.desktop</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Pi Web Server</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>LSBackgroundOnly</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
  </dict>
</plist>
