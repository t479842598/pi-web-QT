!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# Windows Turbopack bug - NUL device file leak
nul

# production
/build
/release

# electron
electron/node_modules/

# tauri (remnants from previous Tauri migration, kept to prevent re-inclusion)
src-tauri/
tauri-dist/
build-app/
build-temp/

# misc
.DS_Store
*.pem
/.agents/
/skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory

.myLastChat
ref-repos
.lrnev/
.reasonix/

# pi todo tool local state
/.pi/

# local port/temp data files (not part of the project)
/可用端口列表.txt
/可用端口清单.tsv

# mobile (Flutter) build artifacts
/mobile/.dart_tool/
/mobile/build/
/mobile/.flutter-plugins-dependencies
/mobile/android/local.properties
/mobile/android/.gradle/
/mobile/ios/Pods/
/mobile/ios/.symlinks/
/mobile/ios/Flutter/ephemeral/
/mobile/ios/Flutter/Generated.xcconfig
/mobile/ios/Flutter/flutter_export_environment.sh

# mobile APK/AAB build artifacts copied to the repo root for manual sharing
/pi-mobile-*.apk
/pi-mobile-*.aab

# local tooling / scratch (not part of releases)
.kunsdd/
.tmp-*.py
*.tgz

# WorkBuddy workspace memory / local session data (never commit)
.workbuddy/
.dsh-file-claim/

# desktop (Tauri)
/desktop/target/
/desktop/target-win/
/desktop/gen/
/desktop/.tauri/

# updater signing keys (private — never commit)
/desktop/.keys/

# Tauri mobile artifacts
/pi-web-new-*.apk
/pi-web-new-*.ipa
/desktop/node_modules/
progress.md

.playwright-mcp/
.zcode/plans/
.mimosa/

